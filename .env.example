# AdviShopping — environment variables.
# Copy this file to `.env.local` and fill in the values. NEVER commit `.env.local`.
# Variables starting with NEXT_PUBLIC_ are baked into the browser bundle at BUILD
# time (and are visible to visitors): change one and you must rebuild/redeploy.

# ---- Supabase (required) ----------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# service_role key: SERVER and local scripts ONLY. It bypasses row-level security,
# so it must never reach the browser or the repository.
SUPABASE_SERVICE_KEY=your-service-role-key

# ---- Groq (needed for the chat agent, search summaries and Document AI) -------
# https://console.groq.com -> API Keys
GROQ_API_KEY=gsk_your_key
# Optional: override the default model if Groq retires it (see README Troubleshooting).
# GROQ_MODEL=qwen/qwen3.8-27b

# ---- Optional ----------------------------------------------------------------
# Secret for the /api/revalidate webhook (any random string).
REVALIDATION_TOKEN=change-me

# One-click "Try the demo" button on /login. PUBLIC by design (shown to visitors):
# use a throwaway password, then run `node scripts/create-demo-user.mjs` once.
# NEXT_PUBLIC_DEMO_EMAIL=demo@example.com
# NEXT_PUBLIC_DEMO_PASSWORD=a-throwaway-password

# Absolute URL for link-preview (Open Graph) images. Render sets RENDER_EXTERNAL_URL itself.
# NEXT_PUBLIC_SITE_URL=https://your-app.onrender.com

# Small hosts (about 512 MB RAM): switch off the heavy models.
# DISABLE_RERANKER=true          # saves ~80 MB (skips the cross-encoder stage)
# DISABLE_VISUAL_SEARCH=true     # saves ~150 MB (image search returns a clear "disabled" message)
