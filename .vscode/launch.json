{
  "version": "0.2.0",
  "configurations": [
    {
      // SERVER-side breakpoints: src/app/api/**/route.ts, src/lib/*.ts
      // NOTE: do NOT add NODE_OPTIONS=--inspect here. "type": "node" already
      // attaches VS Code's own inspector; a second one collides on port 9229
      // and the debugger silently fails to bind.
      // Also intentionally no --turbopack: its source maps break breakpoints.
      "name": "Next.js: debug server-side",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // CLIENT-side breakpoints: src/components/*.tsx (e.g. ChatWidget send())
      // Start the server first, then launch this.
      "name": "Next.js: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    }
  ]
}
